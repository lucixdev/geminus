{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Geminus",
  "mainBinaryName": "geminus",
  "version": "1.0.1",
  "identifier": "org.codeberg.lucixdev.geminus",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GEMINUS",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "lucixdev",
    "copyright": "Copyright (C) 2026 lucix.dev <lucix.dev@proton.me>",
    "licenseFile": "../LICENSE",
    "shortDescription": "Compare two disks or folders",
    "longDescription": "GEMINUS compares two disks or two folders and shows side by side what is identical, what changed and what exists on one side only. Differences can then be copied, moved or deleted by dragging them between the two columns. It reads file contents when asked to, keeps working on slow or damaged disks, and can check the physical health of the drives before comparing them.",
    "resources": {
      "../LICENSE": "LICENSE",
      "../LICENSE-EXCEPTION.txt": "LICENSE-EXCEPTION.txt",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/doc/geminus/copyright": "../LICENSE"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/licenses/geminus/LICENSE": "../LICENSE"
        }
      }
    },
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
